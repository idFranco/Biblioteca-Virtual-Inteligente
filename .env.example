# ============================================================================
# Biblioteca Virtual Inteligente — Variables de entorno (plantilla)
# Copia este archivo a .env y completa los valores reales.
# Ningún valor real debe commitearse. Política fail-fast (ADR-025).
# Este archivo está alineado con .env (mismos nombres/valores seguros);
# los datos sensibles se dejan vacíos o comentados.
# ============================================================================

# ---------- Backend (ASP.NET Core) ----------
# Entorno de ejecución: Development / Production
ASPNETCORE_ENVIRONMENT=Development
# URL de escucha del backend
ASPNETCORE_URLS=http://+:5000
# Ruta del SQLite (ruta o "Data Source=..."). Local: ../database/BibliotecaVirtual.db
SQLITE_DATA_SOURCE=../database/BibliotecaVirtual.db
# Clave de firma JWT (>= 32 bytes, HS256). OBLIGATORIA — Generar con: openssl rand -base64 48
# Se lee en .NET como Jwt:Key (el separador doble guion bajo __ mapea a ':')
JWT__KEY=
# Emisor y audiencia del JWT
JWT__ISSUER=BibliotecaVirtual
JWT__AUDIENCE=BibliotecaVirtual
# Origen(es) CORS separados por comas. Ej. http://localhost:5173
CORS_ORIGINS=http://localhost:5173
# Credenciales del admin sembrado
ADMIN_EMAIL=admin@biblioteca.local
# Debe cumplir la policy de Identity: >= 8 chars, 1 mayúscula, 1 dígito
ADMIN_PASSWORD=
# Rate limit del login (peticiones/minuto)
AUTH_RATE_LIMIT_PER_MINUTE=10
# Intervalo del servicio de notificaciones (segundos). Se lee en .NET como Notifications:CheckIntervalSeconds
NOTIFICATIONS__CHECK_INTERVAL_SECONDS=3600

# Opcionales backend (baseline en appsettings.json; se sobreescriben por env)
CatalogSeed__Enabled=true
# CatalogSeed__FilePath=data/seed-books.json
# Jwt__AccessTokenExpirationMinutes=15
# Jwt__RefreshTokenExpirationDays=7

# ---------- Frontend (React + Vite, build-time) ----------
VITE_API_BASE_URL=http://localhost:5000
VITE_CHATBOT_API_BASE_URL=http://localhost:8000

# ---------- Chatbot (FastAPI) ----------
CHATBOT_HOST=0.0.0.0
CHATBOT_PORT=8000
# Clave de la API Groq usada SOLO por Security-Audit-MCP para auditar entrada/salida (ADR-029)
API_KEY_GROQ=
# Comandos MCP en modo stdio (rutas dentro de la imagen del chatbot). Ej.: "python /app/workflow/mcp/biblioteca-mcp/server.py"
BIBLIOTECA_MCP_COMMAND=python /app/workflow/mcp/biblioteca-mcp/server.py
SECURITY_AUDIT_MCP_COMMAND=python /app/workflow/mcp/security-audit-mcp/server.py
OPEN_LIBRARY_MCP_COMMAND=python /app/workflow/mcp/open-library-mcp/server.py

# Bases SQLite dentro del volumen compartido database_data (obligatorias en Docker).
# El chatbot las recibe desde este archivo vía env_file (US-018/ADR-033): el valor
# debe ser la ruta in-image absoluta, sin importar los exports del shell del host.
# Nativo (standalone): ./workflow/database/BibliotecaVirtual.db
DATABASE_PATH=/app/database/BibliotecaVirtual.db
AUDIT_DATABASE_PATH=/app/database/audit.db

# Base SQLite de memoria conversacional del chatbot (US-019/ADR-035).
# Archivo exclusivo del chatbot dentro del volumen database_data; NO comparte
# esquema con la BD core. Reutiliza el mismo conversationId entre turnos para
# conservar contexto. El compose lo inyecta vía env_file.
# - Nativo (standalone): ./workflow/database/chat_memory.db
# - Docker: /app/database/chat_memory.db
CHAT_MEMORY_DB_PATH=./workflow/database/chat_memory.db

# LLM local Ollama — prioridad sobre la nube (US-016/ADR-023/029).
# OLLAMA_MODEL y LLM_TIMEOUT_SECONDS son obligatorias cuando se define OLLAMA_BASE_URL.
# Topología host (US-017): el chatbot consume el Ollama nativo del host.
#  - Nativo (standalone): OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
#  - Docker: usa host.docker.internal (host-gateway) y se inyecta por compose
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
OLLAMA_MODEL=llama3.2
LLM_TIMEOUT_SECONDS=120

# Modelo/parámetros del LLM de auditoría GROQ (Security-Audit-MCP, ADR-029)
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_SECONDS=10

# ---------- Open Library MCP (enriquecimiento externo) ----------
OPEN_LIBRARY_BASE_URL=https://openlibrary.org
OPEN_LIBRARY_TIMEOUT=10
OPEN_LIBRARY_SEARCH_LIMIT=5

# ---------- Opcionales / herramientas de IA (no activas por defecto) ----------
# LLM en la nube (fallback cloud del chatbot, ADR-023/029): solo si Ollama falla.
# Si LLM_API_KEY se define, LLM_MODEL es obligatoria. Comentar = mismo comportamiento que .env.
# LLM_API_KEY=
# LLM_MODEL=gpt-4o-mini
# Token de GitHub para herramientas de IA (opencode / CI). Placeholder.
# GITHUB_TOKEN=ghp_tu_token_aqui
