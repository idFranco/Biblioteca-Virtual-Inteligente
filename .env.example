# ── Backend (workflow/backend) ────────────────────────────────
# Clave simétrica de firma JWT (obligatoria; el stack no arranca sin ella)
# Generar con: openssl rand -base64 48
JWT_KEY=

# Cuenta administradora inicial (se siembra en el primer arranque)
# La contraseña debe cumplir la policy de Identity: >= 8 chars, 1 mayúscula, 1 dígito
ADMIN_EMAIL=admin@biblioteca.local
ADMIN_PASSWORD=

# Límite de intentos de autenticación por minuto (opcional, default 10)
AUTH_RATE_LIMIT_PER_MINUTE=10

# Connection string SQLite del backend (opcional; si se deja vacío se usa el default)
# Local: Data Source=./workflow/database/BibliotecaVirtual.db
# Docker: lo define el compose en /app/database/BibliotecaVirtual.db (volumen database_data)
SQLITE_DATA_SOURCE=

# ── Frontend (workflow/frontend) ──────────────────────────────
# URL base de la API que embebe el bundle (build arg VITE_API_BASE_URL en Docker)
VITE_API_BASE_URL=http://localhost:5000

# ── Chatbot (workflow/chatbot) ────────────────────────────────
# Host/puerto de escucha de uvicorn (opcionales, defaults 0.0.0.0:8000)
CHATBOT_HOST=0.0.0.0
CHATBOT_PORT=8000

# Orígenes CORS permitidos para el chatbot (obligatoria, fail-fast; separados por coma)
# SPA React en :5173 → chatbot en :8000 (ADR-031)
CORS_ORIGINS=http://localhost:5173

# ── Chatbot: LLM local Ollama (recomendaciones, primario) ──────
# Ollama llama3.2 es el proveedor primario de recomendaciones (ADR-023/029)
# Topología host (US-017): el chatbot consume el Ollama nativo del host vía host-gateway.
# El compose ya NO incluye un servicio ollama (el puerto 11434 queda en manos del host).
# Docker Desktop: funciona sin cambios extra (su proxy alcanza el loopback del host).
# Docker Engine nativo: requiere OLLAMA_HOST=0.0.0.0 en el systemd de Ollama
#   (drop-in /etc/systemd/system/ollama.service.d/override.conf + daemon-reload + restart).
# Nota: compose resuelve las sustituciones ${VAR} de `environment:` dando PRIORIDAD
# al shell del host sobre este archivo. DATABASE_PATH y AUDIT_DATABASE_PATH ya NO
# usan esa vía: el servicio chatbot las inyecta directamente desde este archivo con
# `env_file` (US-018/ADR-033), que nunca consulta el entorno del shell.
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
OLLAMA_MODEL=llama3.2
LLM_TIMEOUT_SECONDS=120

# ── Chatbot: LLM en la nube (fallback cloud, opcional) ────────
# Solo se usa si Ollama no está disponible o no responde (ADR-023)
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# ── Herramientas de IA (opencode / MCP) ──────────────────────
GITHUB_TOKEN=ghp_tu_token_aqui

# Bases SQLite dentro del volumen compartido database_data (obligatorias en Docker).
# El chatbot las recibe desde este archivo vía env_file (US-018/ADR-033): el valor
# debe ser la ruta in-image absoluta, sin importar los exports del shell del host.
DATABASE_PATH=/app/database/BibliotecaVirtual.db
AUDIT_DATABASE_PATH=/app/database/audit.db

# Base SQLite de memoria conversacional del chatbot (US-019/ADR-035).
# Archivo exclusivo del chatbot dentro del volumen database_data; NO comparte
# esquema con la BD core. Reutiliza el mismo conversationId entre turnos para
# conservar contexto. El compose lo inyecta vía env_file.
# Local (standalone): ./workflow/database/chat_memory.db
CHAT_MEMORY_DB_PATH=/app/database/chat_memory.db

# Comandos stdio de los 3 MCP empaquetados en la imagen del chatbot (ADR-030)
# Se invocan en-imagen con python (sin npx)
BIBLIOTECA_MCP_COMMAND=python /app/workflow/mcp/biblioteca-mcp/server.py
SECURITY_AUDIT_MCP_COMMAND=python /app/workflow/mcp/security-audit-mcp/server.py
OPEN_LIBRARY_MCP_COMMAND=python /app/workflow/mcp/open-library-mcp/server.py

# Clave de Groq usada SOLO por Security-Audit-MCP para auditar entrada/salida del chatbot (ADR-029)
API_KEY_GROQ=
