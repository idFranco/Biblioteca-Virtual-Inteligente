# ── Backend (workflow/backend) ────────────────────────────────
# Clave simétrica de firma JWT (obligatoria; el stack no arranca sin ella)
# Generar con: openssl rand -base64 48
JWT_KEY=

# Cuenta administradora inicial (se siembra en el primer arranque)
# La contraseña debe cumplir la policy de Identity: >= 8 chars, 1 mayúscula, 1 dígito
ADMIN_EMAIL=admin@biblioteca.local
ADMIN_PASSWORD=

# Límite de intentos de autenticación por minuto (opcional, default 10)
AUTH_RATE_LIMIT_PER_MINUTE=10

# ── Frontend (workflow/frontend) ──────────────────────────────
# URL base de la API en desarrollo local (en Docker lo fija el build arg VITE_API_BASE_URL)
# VITE_API_BASE_URL=http://localhost:5000

# ── Herramientas de IA (opencode / MCP) ──────────────────────
GITHUB_TOKEN=ghp_tu_token_aqui
DATABASE_PATH=./workflow/database/BibliotecaVirtual.db
